#!/bin/bash

set -e

sln_files=$(find . -maxdepth 2 -name "*.sln" 2>/dev/null)

if [ -z "$sln_files" ]; then
    echo "No solution file found, skipping pre-push checks."
    exit 0
fi

echo "Running pre-push checks..."

dotnet build
dotnet csharpier --check .
dotnet outdated --version-lock Minor --fail-on-updates

echo "Pre-push checks passed."
